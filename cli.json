{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "system"
  },
  "session": {
    "sidebar": "auto",
    "thinking": "hide",
    "tps": true,
    "markdown": "rendered"
  },
  "tabs": {
    "mode": "auto",
    "scope": "global"
  },
  "keybinds": {
    "input_submit": "ctrl+return",
    "input_newline": "return,shift+return,alt+return,ctrl+j"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "attention": {
    "notifications": true,
    "sound": false
  }
}
